# Set these in ModelScope Secrets at runtime, NOT in Dockerfile / public git.
# REQUIRED: paste the actual HTTPS app origin shown by ModelScope, not the Studio page URL.
PUBLIC_ORIGIN=
AUTH_USERNAME=zephyr
# REQUIRED: replace with a new random password of at least 16 characters.
AUTH_PASSWORD=
# REQUIRED on first boot: exactly 8 printable ASCII characters (VNC limitation).
VNC_PASSWORD=
# Optional compatible cloud model. Obtain model IDs from your provider.
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=
HERMES_MODEL=
# Optional; leave 0 unless Chrome explicitly fails due to platform sandbox limits.
CHROME_NO_SANDBOX=0
# Separate from the original /mnt/workspace/zephyr; original data is not deleted.
DATA_ROOT=/mnt/workspace/zephyr-v2

# Set these in ModelScope Secrets at runtime, NOT in Dockerfile / public git.
# REQUIRED: paste the actual HTTPS app origin shown by ModelScope, not the Studio page URL.
PUBLIC_ORIGIN=
AUTH_USERNAME=zephyr
# REQUIRED: replace with a new random password of at least 16 characters.
AUTH_PASSWORD=
# REQUIRED: 8-64 printable ASCII characters. The VNC protocol derives its key
# from only the first 8 characters; longer values are truncated by the protocol.
VNC_PASSWORD=
# REQUIRED: 8-256 characters without control characters. Re-applied to the
# hermes account on every boot so the KDE idle lock screen can be unlocked
# (/etc/shadow lives in the ephemeral container layer and is not persistent).
DESKTOP_PASSWORD=
# Optional compatible cloud model. Obtain model IDs from your provider.
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=
HERMES_MODEL=
# Optional; leave 0 unless Chrome explicitly fails due to platform sandbox limits.
CHROME_NO_SANDBOX=0
# Optional desktop resolution as WIDTHxHEIGHT (bootstrap validates the shape).
DESKTOP_GEOMETRY=1280x800
# Separate from the original /mnt/workspace/zephyr; original data is not deleted.
DATA_ROOT=/mnt/workspace/zephyr-v2

# =============================================================================
# Zephyr AI Desktop — llama.cpp 启动环境变量
# =============================================================================
# 此文件由 entrypoint.sh 在启动 supervisord 前 source。
# supervisord.conf 中 llama-cpp program 的 command 引用这些变量。
#
# 维护者：极客-AI模型通
# =============================================================================

# 模型路径（修正：实际文件名是大写 Qwen3-8B-Q4_K_M.gguf）
# 方案文档写的 qwen3-8b-q4_k_m.gguf（小写）是错误的，实际文件名见上
LLAMA_CPP_MODEL_PATH="${LLAMA_CPP_MODEL_PATH:-/mnt/workspace/zephyr/models/unsloth/Qwen3-8B-GGUF/Qwen3-8B-Q4_K_M.gguf}"

# 绑定地址与端口（仅 loopback，不对外）
LLAMA_CPP_HOST="127.0.0.1"
LLAMA_CPP_PORT="8081"

# 上下文窗口大小（8K，平衡内存与效果）
LLAMA_CPP_CTX_SIZE="${LLAMA_CPP_CTX_SIZE:-8192}"

# CPU 线程数（建议 = 核数 - 1，预留 1 核给其他服务）
# 魔搭 Docker Space 默认 2 核，设为 1 避免抢占
LLAMA_CPP_THREADS="${LLAMA_CPP_THREADS:-1}"

# 并行批处理数
LLAMA_CPP_BATCH_SIZE="${LLAMA_CPP_BATCH_SIZE:-512}"

# GPU 层（CPU only 模式设为 0）
LLAMA_CPP_NGPU_LAYERS="${LLAMA_CPP_NGPU_LAYERS:-0}"

# Flash Attention（CPU 模式建议关闭）
LLAMA_CPP_FLASH_ATTN="${LLAMA_CPP_FLASH_ATTN:-off}"

# 模型别名（Open WebUI 连接时显示的名称）
LLAMA_CPP_MODEL_ALIAS="${LLAMA_CPP_MODEL_ALIAS:-qwen3-8b-local}"

# API Key 认证（§M2 修复：防止容器内未授权调用 llama.cpp 推理端点）
# Open WebUI 的 OPENAI_API_KEY 需与此值一致
LLAMA_CPP_API_KEY="${LLAMA_CPP_API_KEY:-sk-zephyr-local-internal}"

# 完整启动命令（供参考，supervisord.conf 已通过 %(ENV_*)s 引用各变量）
# 注意：supervisord.conf 中的 llama-cpp program 直接使用 %(ENV_LLAMA_CPP_*)s 引用，
# 此处的 LLAMA_CPP_START_CMD 仅作文档参考，不被 supervisord 加载。
LLAMA_CPP_START_CMD="/opt/llama.cpp/llama-server \
  --host ${LLAMA_CPP_HOST} \
  --port ${LLAMA_CPP_PORT} \
  --model ${LLAMA_CPP_MODEL_PATH} \
  --ctx-size ${LLAMA_CPP_CTX_SIZE} \
  --threads ${LLAMA_CPP_THREADS} \
  --batch-size ${LLAMA_CPP_BATCH_SIZE} \
  --n-gpu-layers ${LLAMA_CPP_NGPU_LAYERS} \
  --alias ${LLAMA_CPP_MODEL_ALIAS} \
  --api-key ${LLAMA_CPP_API_KEY}"

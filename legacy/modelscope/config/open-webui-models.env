# =============================================================================
# Zephyr AI Desktop — Open WebUI 双后端对接配置
# =============================================================================
# 此文件供 Open WebUI 初始化时使用，配置本地 llama.cpp 和 ModelScope API 两个后端。
# 用户在 Open WebUI 下拉框中切换本地/API 模型。
#
# 方案文档 §8.3 定义的双后端架构：
#   本地 → llama.cpp (127.0.0.1:8081) — 日常 80% 对话
#   API  → ModelScope API — 复杂推理/长文/代码
#
# 修正（相比现有 supervisord.conf）：
#   原 supervisord.conf 中 Open WebUI 的 OPENAI_API_BASE_URL 指向了
#   Hermes Gateway (8642)，这是错误的。Open WebUI 应指向 llama.cpp (8081)
#   做本地默认，ModelScope API 在界面里配第二个连接。
#
# 维护者：极客-AI模型通
# =============================================================================

# ---------------------------------------------------------------------------
# Open WebUI 环境变量
# ---------------------------------------------------------------------------

# 数据目录（持久化）
DATA_DIR="/mnt/workspace/zephyr/open-webui"

# 本地后端：llama.cpp（默认主后端）
# 修正：原 supervisord.conf 写的 http://127.0.0.1:8642/v1 (Hermes Gateway) 是错误的
#       应指向 llama.cpp server 的 OpenAI 兼容端点
OPENAI_API_BASE_URL="http://127.0.0.1:8081/v1"

# 本地后端 API Key（§M2 修复：与 llama.cpp 的 --api-key 保持一致）
# supervisord.conf 中 Open WebUI 的 OPENAI_API_KEY 引用 %(ENV_LLAMA_CPP_API_KEY)s
OPENAI_API_KEY="sk-zephyr-local-internal"

# Open WebUI 服务绑定（仅 loopback）
OPENWEBUI_HOST="127.0.0.1"
OPENWEBUI_PORT="8082"

# 默认模型（本地 Qwen3-8B）
# llama.cpp 启动时 --alias qwen3-8b-local，Open WebUI 显示此名称
OPENWEBUI_DEFAULT_MODEL="qwen3-8b-local"

# ---------------------------------------------------------------------------
# ModelScope API 后端（用户在 Open WebUI 界面里手动添加第二个连接）
# ---------------------------------------------------------------------------

# 连接配置（用户在 Settings → Connections → OpenAI API 中添加）：
#
#   连接名称: ModelScope API
#   Base URL: https://api-inference.modelscope.cn/v1
#   API Key:  ${MODELSCOPE_API_KEY}  (ms-xxxxxxxx)
#
# 可用模型 ID（在模型下拉框中出现）：
#   - Qwen/Qwen3-235B-A22B-Instruct-2507   (通用对话，推荐)
#   - Qwen/Qwen3-235B-A22B                 (思考模式)
#   - Qwen/Qwen3-Coder-480B-A35B-Instruct  (代码生成)
#
# 免费额度: 每日 2000 次调用

# ---------------------------------------------------------------------------
# supervisord.conf Open WebUI 配置修正
# ---------------------------------------------------------------------------
# 原配置（有问题）:
#   [program:open-webui]
#   environment=DATA_DIR="...",OPENAI_API_BASE_URL="http://127.0.0.1:8642/v1"
#
# 修正后:
#   [program:open-webui]
#   command=open-webui serve --host 127.0.0.1 --port 8082
#   autostart=true
#   autorestart=true
#   priority=60
#   user=root
#   environment=DATA_DIR="/mnt/workspace/zephyr/open-webui", \
#     OPENAI_API_BASE_URL="http://127.0.0.1:8081/v1", \
#     OPENAI_API_KEY="sk-zephyr-local-internal", \
#     OPENWEBUI_DEFAULT_MODEL="qwen3-8b-local"
#   stdout_logfile=/var/log/supervisor/open-webui.log
#   stderr_logfile=/var/log/supervisor/open-webui-err.log
#   startretries=3
#   startsecs=5
#   # supervisord 不支持 depends_on，用 priority 控制启动顺序
#   # llama-cpp priority=60 先启动，open-webui priority=65 后启动

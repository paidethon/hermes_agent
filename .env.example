# =============================================================================
# Zephyr AI Desktop — 环境变量模板
# =============================================================================
# 用法：cp .env.example .env，填入真实值后 docker compose up --build
# 魔搭部署：在 ModelScope Space 设置页的 Secrets/环境变量中逐项配置
#
# 安全原则（林深-安全合规员 §8）：
#   - 本文件只放模板占位符，真实密钥绝不提交进仓库
#   - .env 已在 .gitignore 中排除
# =============================================================================

# ── 必需：Portal Basic Auth（Nginx 门户登录，缺失则容器拒绝启动）──────────
PORTAL_USER=admin
PORTAL_PASSWORD=change-me-strong-password

# ── 必需：VNC 桌面密码（>=8位，必须含字母+数字，缺失则容器拒绝启动）───────
VNC_PASSWORD=change-me-vnc-pass1

# ── 可选：OneDrive 备份（两项必须同时配置，缺一即失败；全空则跳过备份）────
# 2026-08-09 起移除 crypt 加密层，备份直接明文写入 onedrive:zephyr-backup
# ONEDRIVE_TOKEN 获取：rclone authorize "onedrive"（本地执行后复制 token JSON）
# ONEDRIVE_DRIVE_ID 获取：rclone config 中 onedrive remote 的 drive_id
ONEDRIVE_TOKEN=
ONEDRIVE_DRIVE_ID=

# ── 可选：Hermes Gateway API 密钥 ─────────────────────────────────────────
# 留空 = entrypoint 自动生成 32 位强密钥，持久化到
#        /mnt/workspace/zephyr/config/hermes-api-key（chmod 600），重启自动复用
# 注意：若手动设置，必须 >=16 位 —— gateway 的 api_server 平台只在密钥
#       >=16 位时才会注册启动（hermes-agent 源码 _has_usable_api_server_key）
HERMES_API_KEY=

# ── 可选：ModelScope 云 API（双后端的云端推理部分，免费额度 2000 次/天）────
# 获取：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# ── 可选：Flowise 凭据 ────────────────────────────────────────────────────
# 留空 = entrypoint 首次启动自动生成强密码，持久化到
#        /mnt/workspace/zephyr/config/flowise-credentials.env（chmod 600）
# 重启后自动复用，无需重新配置
FLOWISE_USER=
FLOWISE_PASSWORD=

# =============================================================================
# GitHub Actions Secrets（仓库 Settings → Secrets and variables → Actions）
# 以下不写入 .env，仅供 .github/workflows/keepalive.yml 使用：
#   MODELSCOPE_TOKEN — ModelScope API Token（同 MODELSCOPE_API_KEY）
#   SPACE_ID         — 魔搭空间 ID（如 zephyr17/hermes_agent）
#   ALERT_WEBHOOK    — 可选，部署失败告警的 webhook URL（钉钉/飞书机器人等）
# =============================================================================
